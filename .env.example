# Site URL used for OG tags and canonical links
NUXT_PUBLIC_SITE_URL=https://patryksmakosz.com

# Video CDN base URL (Cloudflare R2). Leave empty for local dev.
# In production, set to your R2 public URL (e.g., https://pub-xxxxx.r2.dev)
NUXT_PUBLIC_VIDEO_BASE_URL=

# Staging gate, read by scripts/deploy.mjs for its live checks
STAGE_AUTH_USER=
STAGE_AUTH_PASS=
