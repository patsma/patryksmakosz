{
  "id": "example-studio",
  "baseUrl": "https://example.com/",
  "hide": ["#axeptio_overlay", ".axeptio_mount"],
  "devices": ["desktop", "mobile"],
  "shots": [
    { "name": "home-scroll", "path": "/", "actions": [{ "scroll": { "to": "bottom", "speed": 700 } }] },
    {
      "name": "section-moment",
      "path": "/",
      "actions": [{ "scroll": { "to": "section:nth-of-type(3)", "speed": 600 } }, { "pause": 3000 }]
    },
    {
      "name": "page-transition",
      "path": "/",
      "devices": ["desktop"],
      "actions": [{ "pause": 1500 }, { "click": "header nav a" }, { "pause": 3500 }, { "scroll": { "to": 1800, "speed": 500 } }]
    }
  ]
}
